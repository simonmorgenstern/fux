<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LED Visualization - FUX Main Strip</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: sans-serif;
            background: #111;
            color: #ccc;
            display: flex;
            flex-direction: column;
            height: 100vh;
            padding: 20px;
        }
        header {
            text-align: center;
            margin-bottom: 20px;
        }
        h1 {
            font-size: 24px;
            margin-bottom: 8px;
        }
        .info {
            font-size: 14px;
            opacity: 0.7;
        }
        .canvas-container {
            flex: 1;
            border: 1px solid #333;
            border-radius: 8px;
            overflow: hidden;
            background: #1a1a1a;
            position: relative;
        }
        canvas {
            display: block;
            width: 100%;
            height: 100%;
        }
        footer {
            text-align: center;
            margin-top: 20px;
            font-size: 12px;
            opacity: 0.6;
        }
        #tooltip {
            position: absolute;
            background: rgba(0, 0, 0, 0.8);
            color: #fff;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 12px;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.2s;
        }
    </style>
</head>
<body>
    <header>
        <h1>FUX LED Strip Visualization</h1>
        <p class="info">Main strip LEDs (0–267) shown as gray circles. Hover over a circle to see its index.</p>
    </header>
    <div class="canvas-container">
        <canvas id="led-canvas"></canvas>
        <div id="tooltip"></div>
    </div>
    <footer>
        <p>Coordinates from ../../assets/coords.json | Simple Canvas Visualization</p>
    </footer>

    <script>
        (async function() {
            // Load coordinate data
            const response = await fetch('../../assets/coords.json');
            if (!response.ok) {
                console.error('Failed to load coordinates');
                return;
            }
            const allLeds = await response.json();
            
            // Take only first 268 LEDs (main strip)
            const leds = allLeds.slice(0, 268);
            
            const canvas = document.getElementById('led-canvas');
            const ctx = canvas.getContext('2d');
            const tooltip = document.getElementById('tooltip');
            
            // Calculate bounding box of the LEDs
            let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
            for (const led of leds) {
                minX = Math.min(minX, led.x);
                maxX = Math.max(maxX, led.x);
                minY = Math.min(minY, led.y);
                maxY = Math.max(maxY, led.y);
            }
            
            // Add a little padding (10%)
            const paddingX = (maxX - minX) * 0.1;
            const paddingY = (maxY - minY) * 0.1;
            minX -= paddingX;
            maxX += paddingX;
            minY -= paddingY;
            maxY += paddingY;
            
            // Mapping from world coordinates to canvas pixels
            let scale = 1;
            let offsetX = 0, offsetY = 0;
            
            function resizeCanvas() {
                const container = canvas.parentElement;
                canvas.width = container.clientWidth;
                canvas.height = container.clientHeight;
                
                // Compute scale to fit all LEDs
                const worldWidth = maxX - minX;
                const worldHeight = maxY - minY;
                const scaleX = canvas.width / worldWidth;
                const scaleY = canvas.height / worldHeight;
                scale = Math.min(scaleX, scaleY);
                offsetX = (canvas.width - worldWidth * scale) / 2 - minX * scale;
                offsetY = (canvas.height - worldHeight * scale) / 2 - minY * scale;
                
                draw();
            }
            
            function worldToCanvas(x, y) {
                return {
                    x: x * scale + offsetX,
                    y: y * scale + offsetY
                };
            }
            
            function draw() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                
                // Draw each LED as a gray circle
                ctx.fillStyle = '#888';
                ctx.strokeStyle = '#ccc';
                ctx.lineWidth = 1;
                
                for (const led of leds) {
                    const pos = worldToCanvas(led.x, led.y);
                    ctx.beginPath();
                    ctx.arc(pos.x, pos.y, 4, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.stroke();
                }
            }
            
            // Hover detection
            let hoverIndex = -1;
            canvas.addEventListener('mousemove', (event) => {
                const rect = canvas.getBoundingClientRect();
                const mouseX = event.clientX - rect.left;
                const mouseY = event.clientY - rect.top;
                
                // Find closest LED within a threshold
                let closestDist = Infinity;
                let closestIndex = -1;
                const threshold = 10; // pixels
                
                for (const led of leds) {
                    const pos = worldToCanvas(led.x, led.y);
                    const dist = Math.hypot(pos.x - mouseX, pos.y - mouseY);
                    if (dist < threshold && dist < closestDist) {
                        closestDist = dist;
                        closestIndex = led.index;
                    }
                }
                
                if (closestIndex !== hoverIndex) {
                    hoverIndex = closestIndex;
                    if (hoverIndex !== -1) {
                        tooltip.textContent = `LED ${hoverIndex}`;
                        const pos = worldToCanvas(
                            leds.find(l => l.index === hoverIndex).x,
                            leds.find(l => l.index === hoverIndex).y
                        );
                        tooltip.style.left = (pos.x + rect.left + 10) + 'px';
                        tooltip.style.top = (pos.y + rect.top - 20) + 'px';
                        tooltip.style.opacity = 1;
                    } else {
                        tooltip.style.opacity = 0;
                    }
                }
            });
            
            canvas.addEventListener('mouseleave', () => {
                tooltip.style.opacity = 0;
                hoverIndex = -1;
            });
            
            // Initialize
            window.addEventListener('resize', resizeCanvas);
            resizeCanvas();
        })();
    </script>
</body>
</html>